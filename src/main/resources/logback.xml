<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_DIR" value="${queueclearance.logDir:-logs}"/>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/queue-clearance.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/queue-clearance.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>300MB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>%date{ISO8601} %-5level [%thread] %logger{36} - %msg%n</pattern></encoder>
    </appender>
    <logger name="com.zaxxer.hikari" level="WARN"/>
    <logger name="com.mysql" level="WARN"/>
    <root level="INFO"><appender-ref ref="FILE"/></root>
</configuration>
